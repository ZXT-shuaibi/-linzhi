# 生产环境配置示例
# 使用前请重命名为 application-prod.yml 并配置实际的密钥

spring:
  application:
    name: zhiguang-be
  datasource:
    url: ${SPRING_DATASOURCE_URL}
    driver-class-name: ${SPRING_DATASOURCE_DRIVER_CLASS_NAME:com.mysql.cj.jdbc.Driver}
    username: ${SPRING_DATASOURCE_USERNAME}
    password: ${SPRING_DATASOURCE_PASSWORD}
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}
  sql:
    init:
      mode: ${SPRING_SQL_INIT_MODE:never}

server:
  port: 8080

snowflake:
  worker-id: ${SNOWFLAKE_WORKER_ID}
  datacenter-id: ${SNOWFLAKE_DATACENTER_ID}

security:
  refresh-store: redis
  cors:
    allowed-origins: ${SECURITY_CORS_ALLOWED_ORIGINS}
  login-blacklist:
    enabled: true
  jwt:
    issuer: zhiguang-be
    key-id: zhiguang-rsa
    access-token-ttl-minutes: 15
    refresh-token-ttl-days: 7
    # 生产环境必须配置持久化的 RSA 密钥
    # 生成密钥命令：
    # openssl genrsa -out private.pem 2048
    # openssl rsa -in private.pem -pubout -out public.pem
    # 然后将密钥内容（包括 -----BEGIN/END----- 行）复制到下方，使用 \n 表示换行
    public-key: ${JWT_PUBLIC_KEY}
    private-key: ${JWT_PRIVATE_KEY}
    # 生产环境必须设置为 false
    allow-ephemeral-keys: false
    # 历史 kid 公钥只用于验签，不参与新 token 签发；滚动换钥时保留到旧 token 自然过期
    # verification-keys:
    #   - key-id: zhiguang-rsa-previous
    #     public-key: ${JWT_PREVIOUS_PUBLIC_KEY}
